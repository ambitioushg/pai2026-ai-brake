<?xml version="1.0" encoding="UTF-8"?>
<!--
  カメラ画像（640x640 RGB = 約 1.2 MB/枚）を取りこぼさずに送るための Fast DDS 設定。
  既定の共有メモリ領域（0.5 MB）より大きいメッセージは UDP に分割されて落ちやすいため、
  共有メモリの領域を 32 MB に広げる。sim.launch.py が FASTRTPS_DEFAULT_PROFILES_FILE で読み込む。
-->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>large_shm</transport_id>
        <type>SHM</type>
        <segment_size>33554432</segment_size>
      </transport_descriptor>
      <transport_descriptor>
        <transport_id>udp</transport_id>
        <type>UDPv4</type>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="ai_brake_participant" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>large_shm</transport_id>
          <transport_id>udp</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>

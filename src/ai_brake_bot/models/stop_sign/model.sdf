<?xml version="1.0"?>
<!--
  止まれ標識（STOP）。表面は +X 向き。
  板のメッシュとテクスチャは tools/make_stop_sign.py で生成（対辺距離 0.60 m）。
-->
<sdf version="1.9">
  <model name="stop_sign">
    <static>true</static>
    <link name="link">
      <collision name="pole_collision">
        <pose>0 0 0.725 0 0 0</pose>
        <geometry><cylinder><radius>0.03</radius><length>1.45</length></cylinder></geometry>
      </collision>
      <visual name="pole">
        <pose>0 0 0.725 0 0 0</pose>
        <geometry><cylinder><radius>0.03</radius><length>1.45</length></cylinder></geometry>
        <material>
          <ambient>0.55 0.55 0.55 1</ambient>
          <diffuse>0.6 0.6 0.6 1</diffuse>
        </material>
      </visual>
      <visual name="sign">
        <pose>0.037 0 1.45 0 0 0</pose>
        <geometry>
          <mesh><uri>meshes/stop_sign.obj</uri></mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>

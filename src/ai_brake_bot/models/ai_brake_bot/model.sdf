<?xml version="1.0"?>
<!--
  AI ブレーキ実験用の差動二輪ロボット
  - 車体 0.50 x 0.36 x 0.16 m、後輪 2 輪（半径 0.08 m）+ 前キャスター
  - 高さ 0.70 m のマスト先端に前向きカメラ（640x640, 水平・垂直画角 1.5 rad, 15 fps）
    ※ カメラの高さ・画角を変えたら config/params.yaml の camera_height / camera_hfov も合わせる
  - 車体前端に近距離用の 2D LiDAR（/scan）
  - /cmd_vel で走行、/odom にオドメトリを出す（gz-sim DiffDrive）
-->
<sdf version="1.9">
  <model name="ai_brake_bot" canonical_link="base_link">

    <link name="base_link">
      <pose relative_to="__model__">0 0 0.13 0 0 0</pose>
      <inertial>
        <mass>8.0</mass>
        <inertia>
          <ixx>0.1035</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.1837</iyy><iyz>0</iyz>
          <izz>0.2531</izz>
        </inertia>
      </inertial>
      <collision name="chassis_collision">
        <geometry><box><size>0.50 0.36 0.16</size></box></geometry>
      </collision>
      <visual name="chassis">
        <geometry><box><size>0.50 0.36 0.16</size></box></geometry>
        <material>
          <ambient>0.10 0.30 0.80 1</ambient>
          <diffuse>0.10 0.30 0.80 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
      <visual name="mast">
        <pose>0.20 0 0.325 0 0 0</pose>
        <geometry><cylinder><radius>0.015</radius><length>0.49</length></cylinder></geometry>
        <material>
          <ambient>0.6 0.6 0.6 1</ambient>
          <diffuse>0.6 0.6 0.6 1</diffuse>
        </material>
      </visual>
      <visual name="camera_head">
        <pose>0.21 0 0.57 0 0 0</pose>
        <geometry><box><size>0.06 0.12 0.05</size></box></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <sensor name="front_camera" type="camera">
        <pose>0.245 0 0.57 0 0 0</pose>
        <camera>
          <horizontal_fov>1.5</horizontal_fov>
          <!-- 正方形にして縦の画角を広げ、近くの人の全身（頭〜足元）が映るようにする -->
          <image>
            <width>640</width>
            <height>640</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>60</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>true</visualize>
        <topic>/camera/image_raw</topic>
      </sensor>
      <!-- 近距離用の 2D LiDAR（前方 ±90°、高さ約 0.23 m で脚を捉える）。カメラの死角を補う -->
      <sensor name="front_lidar" type="gpu_lidar">
        <pose>0.27 0 0.10 0 0 0</pose>
        <lidar>
          <scan>
            <horizontal>
              <samples>181</samples>
              <resolution>1</resolution>
              <min_angle>-1.5708</min_angle>
              <max_angle>1.5708</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.05</min>
            <max>8.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>true</visualize>
        <topic>/scan</topic>
      </sensor>
      <!-- 動画用の追従カメラ（後方上から撮る。AI の判断には使わない。録画時だけ描画される） -->
      <sensor name="chase_camera" type="camera">
        <pose>-1.6 0 1.0 0 0.32 0</pose>
        <camera>
          <horizontal_fov>1.3</horizontal_fov>
          <image>
            <width>640</width>
            <height>640</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>80</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <topic>/chase_camera/image_raw</topic>
      </sensor>
    </link>

    <link name="left_wheel">
      <pose relative_to="__model__">-0.10 0.21 0.08 -1.5707963 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.000867</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000867</iyy><iyz>0</iyz>
          <izz>0.0016</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="right_wheel">
      <pose relative_to="__model__">-0.10 -0.21 0.08 -1.5707963 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.000867</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000867</iyy><iyz>0</iyz>
          <izz>0.0016</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="caster">
      <pose relative_to="__model__">0.18 0 0.04 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.000128</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000128</iyy><iyz>0</iyz>
          <izz>0.000128</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><sphere><radius>0.04</radius></sphere></geometry>
        <surface>
          <friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><sphere><radius>0.04</radius></sphere></geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <pose relative_to="left_wheel"/>
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit>
      </axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <pose relative_to="right_wheel"/>
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit>
      </axis>
    </joint>

    <joint name="caster_joint" type="ball">
      <parent>base_link</parent>
      <child>caster</child>
    </joint>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.42</wheel_separation>
      <wheel_radius>0.08</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <max_linear_velocity>1.2</max_linear_velocity>
      <min_linear_velocity>-0.5</min_linear_velocity>
      <max_angular_velocity>1.5</max_angular_velocity>
      <min_angular_velocity>-1.5</min_angular_velocity>
      <!-- 加速 1.0 m/s^2、ブレーキ（減速）は最大 1.5 m/s^2 -->
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.5</min_linear_acceleration>
    </plugin>
  </model>
</sdf>

<?xml version="1.0"?>
<!--
  AI ブレーキ実験用の街路（ロボットは x=0 から +x 方向へ走る）

    x =  6.0 : 止まれ標識（右側）              → 一時停止すべき
    x = 11.0 : 歩道に立つ人（左側の歩道）      → ブレーキ不要（レーン外）
    x = 16.0 : 横断歩道を往復する歩行者        → レーン内にいる間は停止
    x = 24.0 : レーン上に立つ人                → 手前で停止すべき（評価の終点）

  ※ 人物モデルは Gazebo Fuel から初回起動時にダウンロードされる
-->
<sdf version="1.9">
  <world name="town_road">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.70 0.82 0.95 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.9 0.9 0.88 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

    <!-- 地面（芝生） -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material>
            <ambient>0.33 0.50 0.28 1</ambient>
            <diffuse>0.33 0.50 0.28 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 道路・白線・歩道・横断歩道（見た目だけ。走行は地面の上） -->
    <model name="street">
      <static>true</static>
      <link name="link">
        <visual name="road">
          <pose>14.5 0 0.001 0 0 0</pose>
          <geometry><box><size>35 3.0 0.002</size></box></geometry>
          <material><ambient>0.22 0.22 0.23 1</ambient><diffuse>0.22 0.22 0.23 1</diffuse></material>
        </visual>
        <visual name="edge_line_left">
          <pose>14.5 1.38 0.0025 0 0 0</pose>
          <geometry><box><size>35 0.08 0.001</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
        <visual name="edge_line_right">
          <pose>14.5 -1.38 0.0025 0 0 0</pose>
          <geometry><box><size>35 0.08 0.001</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
        <visual name="sidewalk_left">
          <pose>14.5 2.45 0.002 0 0 0</pose>
          <geometry><box><size>35 1.9 0.004</size></box></geometry>
          <material><ambient>0.68 0.66 0.62 1</ambient><diffuse>0.68 0.66 0.62 1</diffuse></material>
        </visual>
        <visual name="sidewalk_right">
          <pose>14.5 -2.35 0.002 0 0 0</pose>
          <geometry><box><size>35 1.7 0.004</size></box></geometry>
          <material><ambient>0.68 0.66 0.62 1</ambient><diffuse>0.68 0.66 0.62 1</diffuse></material>
        </visual>
        <visual name="crosswalk_1">
          <pose>16 -1.05 0.003 0 0 0</pose>
          <geometry><box><size>1.6 0.3 0.001</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
        <visual name="crosswalk_2">
          <pose>16 -0.35 0.003 0 0 0</pose>
          <geometry><box><size>1.6 0.3 0.001</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
        <visual name="crosswalk_3">
          <pose>16 0.35 0.003 0 0 0</pose>
          <geometry><box><size>1.6 0.3 0.001</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
        <visual name="crosswalk_4">
          <pose>16 1.05 0.003 0 0 0</pose>
          <geometry><box><size>1.6 0.3 0.001</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 建物（背景） -->
    <model name="buildings">
      <static>true</static>
      <link name="link">
        <visual name="b1">
          <pose>5 7.0 1.5 0 0 0</pose>
          <geometry><box><size>6 4 3</size></box></geometry>
          <material><ambient>0.85 0.78 0.62 1</ambient><diffuse>0.85 0.78 0.62 1</diffuse></material>
        </visual>
        <visual name="b2">
          <pose>14 7.5 2.5 0 0 0</pose>
          <geometry><box><size>8 5 5</size></box></geometry>
          <material><ambient>0.70 0.55 0.42 1</ambient><diffuse>0.70 0.55 0.42 1</diffuse></material>
        </visual>
        <visual name="b3">
          <pose>25 7.0 2.0 0 0 0</pose>
          <geometry><box><size>7 4 4</size></box></geometry>
          <material><ambient>0.55 0.62 0.72 1</ambient><diffuse>0.55 0.62 0.72 1</diffuse></material>
        </visual>
        <visual name="b4">
          <pose>10 -7.0 2.0 0 0 0</pose>
          <geometry><box><size>7 4 4</size></box></geometry>
          <material><ambient>0.88 0.86 0.80 1</ambient><diffuse>0.88 0.86 0.80 1</diffuse></material>
        </visual>
        <visual name="b5">
          <pose>22 -7.5 3.0 0 0 0</pose>
          <geometry><box><size>9 5 6</size></box></geometry>
          <material><ambient>0.72 0.45 0.40 1</ambient><diffuse>0.72 0.45 0.40 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ロボット -->
    <include>
      <uri>model://ai_brake_bot</uri>
      <name>ai_brake_bot</name>
      <pose>0 0 0.0 0 0 0</pose>
    </include>

    <!-- x = 6: 止まれ標識（表面をロボット側 = -x 方向に向ける） -->
    <include>
      <uri>model://stop_sign</uri>
      <name>stop_sign</name>
      <pose>6.0 -1.9 0 0 0 3.14159</pose>
    </include>

    <!-- x = 11: 歩道に立つ人（レーン外なのでブレーキ不要） -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Casual female</uri>
      <name>sidewalk_person</name>
      <pose>11.0 2.4 0 0 0 0</pose>
    </include>

    <!-- x = 16: 横断歩道を往復する歩行者（道路の中央で 12 秒立ち止まる。周期 50 秒） -->
    <actor name="crossing_person">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk" tension="0">
          <waypoint><time>0</time><pose>16 3.0 1.0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>6</time><pose>16 0.0 1.0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>18</time><pose>16 0.0 1.0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>24</time><pose>16 -3.0 1.0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>25</time><pose>16 -3.0 1.0 0 0 1.5708</pose></waypoint>
          <waypoint><time>31</time><pose>16 0.0 1.0 0 0 1.5708</pose></waypoint>
          <waypoint><time>43</time><pose>16 0.0 1.0 0 0 1.5708</pose></waypoint>
          <waypoint><time>49</time><pose>16 3.0 1.0 0 0 1.5708</pose></waypoint>
          <waypoint><time>50</time><pose>16 3.0 1.0 0 0 -1.5708</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- x = 24: レーン上に立つ人（この手前で止まれるかを評価する） -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Casual female</uri>
      <name>lane_person</name>
      <pose>24.0 0.0 0 0 0 -1.5708</pose>
    </include>
  </world>
</sdf>
